{
	"name": "litlist-server",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc && tsc-alias",
		"build:watch": "concurrently \"tsc --watch\" \"tsc-alias --watch\"",
		"compile-alias": "tsc-alias",
		"compile-alias:watch": "tsc-alias --watch",
		"gql-generate": "graphql-codegen --config codegen.yml",
		"gql-generate:watch": "nodemon --watch schema.graphql --exec \"graphql-codegen --config codegen.yml\"",
		"start": "node ./dist/index.js",
		"dev": "nodemon ./dist/index.js",
		"format": "prettier . --write",
		"lint": "eslint --fix . --ext .ts"
	},
	"engines": {
		"node": ">=16.18.0",
		"npm": ">=8.19.2"
	},
	"license": "ISC",
	"dependencies": {
		"@apollo/datasource-rest": "^6.1.0",
		"@apollo/server": "^4.9.2",
		"body-parser": "^1.20.2",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"graphql": "^16.8.0",
		"serverless-http": "^3.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^5.0.0",
		"@graphql-codegen/typescript": "^4.0.1",
		"@graphql-codegen/typescript-resolvers": "^4.0.1",
		"@graphql-eslint/eslint-plugin": "^4.4.0",
		"@types/node": "^20.5.6",
		"concurrently": "^8.2.1",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"nodemon": "^3.0.1",
		"prettier": "^3.8.1",
		"tsc-alias": "^1.8.7",
		"typescript": "^5.2.2",
		"typescript-eslint": "^8.57.2"
	}
}
