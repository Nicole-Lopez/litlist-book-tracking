{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",

		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],

		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"moduleDetection": "force",

		"strict": true,
		"skipLibCheck": true,

		"esModuleInterop": true,

		"paths": {
			"@gqlTypes": ["./src/generated/graphql.js"],
			"@dataSources/*": ["./src/dataSources/*"],
			"@resolvers/*": ["./src/schema/resolvers/*"],
			"@queries/*": ["./src/schema/resolvers/queries/*"],
			"@models/*": ["./src/models/*"],
			"@customTypes/*": ["./src/types/*"],
			"@utilities/*": ["./src/utilities/*"],
			"@constants/*": ["./src/constants/*"],
			"@adapters/*": ["./src/adapters/*"]
		}
	},
	"exclude": ["node_modules", "dist", "codegen.ts"]
}
