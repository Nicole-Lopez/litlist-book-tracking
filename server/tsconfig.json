{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",

		"target": "ES2022",
		"lib": ["ES2022"],

		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"esModuleInterop": true,
		"strict": true,

		"types": ["node"],

		"moduleDetection": "force",

		"baseUrl": ".",
		"paths": {
			"@gqlTypes": ["src/__generated__/resolvers.generated"],
			"@dataSources/*": ["src/schema/dataSources/*"],
			"@resolvers/*": ["src/schema/resolvers/*"],
			"@queries/*": ["src/schema/resolvers/queries/*"],
			"@models/*": ["src/models/*"],
			"@utilities/*": ["src/utilities/*"],
			"@constants/*": ["src/constants/*"],
			"@adapters/*": ["src/adapters/*"]
		}
	}
}
